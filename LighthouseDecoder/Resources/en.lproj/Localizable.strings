"lh.eddystone.name" = "Eddystone";
"lh.eddystone.story" = "The fourth tower on the same English reef. Granite blocks dovetail like joinery; the keepers used to grow flowers on its lantern gallery before electrification.";
"lh.fastnet.name" = "Fastnet Rock";
"lh.fastnet.story" = "Last sight of Ireland for emigrants crossing to America. Built from Cornish granite on a wave-swept pinnacle in the Atlantic.";
"lh.bellrock.name" = "Bell Rock";
"lh.bellrock.story" = "The oldest sea-washed lighthouse still in use. Robert Stevenson finished it in 1811 after four summers of work between tides.";
"lh.cordouan.name" = "Tour de Cordouan";
"lh.cordouan.story" = "Renaissance lighthouse off Bordeaux, sometimes called the Versailles of the sea. Inside there is a working chapel above the lantern.";
"lh.creach.name" = "Créac'h";
"lh.creach.story" = "Black-and-white striped giant on Ouessant island, one of the most powerful lights on the French coast.";
"lh.jument.name" = "La Jument";
"lh.jument.story" = "Photographer Jean Guichard shot it in 1989 mid-storm — the keeper opening the door, a wave taller than the tower behind him.";
"lh.hercules.name" = "Tower of Hercules";
"lh.hercules.story" = "Roman-built lighthouse in A Coruña, working continuously for over 1,900 years. UNESCO World Heritage site.";
"lh.saovicente.name" = "Cabo de São Vicente";
"lh.saovicente.story" = "South-western tip of Portugal where mariners once thought the world ended. The lantern is one of the brightest in Europe.";
"lh.pharos.name" = "Lighthouse of Alexandria";
"lh.pharos.story" = "Original wonder of the ancient world. Destroyed by earthquakes; the word 'pharos' became the root of lighthouse in many languages.";
"lh.messina.name" = "Punta del Faro";
"lh.messina.story" = "Marks the deadly strait between Scylla and Charybdis. The current here is still the fiercest in the Mediterranean.";
"lh.genova.name" = "La Lanterna";
"lh.genova.story" = "Symbol of Genoa and one of the tallest masonry lighthouses in the world. Visible from 50 km offshore.";
"lh.spartel.name" = "Cap Spartel";
"lh.spartel.story" = "Atlantic gateway to the Strait of Gibraltar, on the north-western corner of Africa. Funded jointly by twelve nations.";
"lh.yaquina.name" = "Yaquina Head";
"lh.yaquina.story" = "Tallest lighthouse on the Oregon coast. Built from bricks shipped around Cape Horn from San Francisco.";
"lh.pointreyes.name" = "Point Reyes";
"lh.pointreyes.story" = "Set low on the cliff to stay below the Pacific fog bank. 308 steps descend to the lantern from the cliff top.";
"lh.splitpoint.name" = "Split Point";
"lh.splitpoint.story" = "Red cap on a white cylinder above the Great Ocean Road, watching the Shipwreck Coast where dozens of clippers ended.";
"lh.reinga.name" = "Cape Reinga";
"lh.reinga.story" = "Northernmost tip of New Zealand where the Pacific and Tasman seas meet. In Māori tradition, souls leap from here to the afterworld.";
"lh.kjeungskjaer.name" = "Kjeungskjær";
"lh.kjeungskjaer.story" = "Octagonal red cast-iron tower in Trøndelag fjord. One of only two lighthouses in Norway with that shape.";
"lh.kopu.name" = "Kõpu";
"lh.kopu.story" = "Begun in 1531 on Hiiumaa island, the oldest continuously working lighthouse in the Baltic and one of the oldest in the world.";
"lh.rubjerg.name" = "Rubjerg Knude";
"lh.rubjerg.story" = "Slowly devoured by a moving dune for a century. In 2019 it was rolled inland on tracks to save it from collapse.";
"lh.svalbard.name" = "Sallyhamna";
"lh.svalbard.story" = "Tiny lantern at 79° North above Spitsbergen. In winter the bay is sea ice; polar bears occasionally check it out.";
"lh.virgenes.name" = "Cabo Vírgenes";
"lh.virgenes.story" = "Marks the Atlantic entrance to the Strait of Magellan. Wind speeds here regularly exceed 100 km/h.";
"lh.agulhas.name" = "Cape Agulhas";
"lh.agulhas.story" = "Southernmost lighthouse of Africa. Old Egyptian-style limestone tower at the geographic boundary between Atlantic and Indian oceans.";

