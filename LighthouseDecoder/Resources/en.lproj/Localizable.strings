"iala.color.r.title" = "R — Red";
"iala.color.r.body" = "Used on port-hand marks and danger sectors.";
"iala.color.g.title" = "G — Green";
"iala.color.g.body" = "Starboard-hand marks in IALA Region A and B.";
"iala.color.y.title" = "Y — Yellow";
"iala.color.y.body" = "Special marks: cables, recreation zones, military exercise areas.";
"iala.color.b.title" = "B — Blue";
