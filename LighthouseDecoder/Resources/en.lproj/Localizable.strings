"iala.struct.tr.body" = "Substantial structure, usually masonry or stone.";
"iala.struct.bn.title" = "Bn — Beacon";
"iala.struct.bn.body" = "Fixed mark on shore or shoal, may be illuminated.";
"iala.struct.ra.title" = "Ra — Radar reflector";
"iala.struct.ra.body" = "Passive radar reflector to make the mark visible to radar.";
"iala.struct.rw.title" = "RW — Racon";
"iala.struct.rw.body" = "Active radar transponder that paints a Morse letter on radar.";

